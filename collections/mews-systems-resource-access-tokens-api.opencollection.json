  "info": {
    "name": "Mews Booking Engine API (Distributor) Account notes Resource access tokens API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ClientToken",
      "value": "{{ClientToken}}",
      "placement": "header"
    }
  },

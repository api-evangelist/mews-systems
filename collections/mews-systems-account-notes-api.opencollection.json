{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mews Booking Engine API (Distributor) Account notes API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ClientToken",
      "value": "{{ClientToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mews Get All Account Notes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mews.com/api/connector/v1/accountNotes/getAll",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns all account notes of an account, optionally filtered by activity state, account identifiers, specific account note identifiers or other filter parameters.\nNote this operation uses [Pagination](https://mews-systems.gitbook.io/connector-api/guidelines/pagination/) and supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property)."
        },
        {
          "info": {
            "name": "Mews Add Account Notes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mews.com/api/connector/v1/accountNotes/add",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds account notes to an account of the enterprise chain. Note this operation supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property)."
        },
        {
          "info": {
            "name": "Mews Update Account Notes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mews.com/api/connector/v1/accountNotes/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates information about the specified account notes."
        },
        {
          "info": {
            "name": "Mews Delete Account Notes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mews.com/api/connector/v1/accountNotes/delete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes specified account notes."
        }
      ]
    }
  ],
  "bundled": true
}
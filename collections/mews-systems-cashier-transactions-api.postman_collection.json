          "name": "Mews Get All Cashier Transactions",
          "request": {
            "name": "Mews Get All Cashier Transactions",
            "description": {
              "content": "Returns all cashier transactions. At least one of the filter parameters `CashierTransactionIds` or `CreatedUtc` must be specified in the request. Note this operation uses [Pagination](../guidelines/pagination.md) and supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property/).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "connector",
                "v1",
                "cashierTransactions",
                "getAll"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },

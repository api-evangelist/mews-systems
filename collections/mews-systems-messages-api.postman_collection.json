          "name": "Mews Get All Messages",
          "request": {
            "name": "Mews Get All Messages",
            "description": {
              "content": "Get all messages belonging to the specified [Message threads](https://mews-systems.gitbook.io/connector-api/operations/messagethreads/#message-thread). Messages can only be returned for message threads you have created. Note this operation uses [Pagination](https://mews-systems.gitbook.io/connector-api/guidelines/pagination/) and supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "connector",
                "v1",
                "messages",
                "getAll"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },

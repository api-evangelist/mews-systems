{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mews Booking Engine API (Distributor) Account notes Images API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ClientToken",
      "value": "{{ClientToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mews Get Image URLs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mews.com/api/connector/v1/images/getUrls",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns URLs of the specified images."
        }
      ]
    }
  ],
  "bundled": true
}
          "name": "Mews Get All Outlet Items",
          "request": {
            "name": "Mews Get All Outlet Items",
            "description": {
              "content": "Returns all outlet items of the enterprise that were consumed (posted) or will be consumed within the specified interval. If the `Currency` is specified, costs of the items are converted to that currency.\nNote this operation uses [Pagination](https://mews-systems.gitbook.io/connector-api/guidelines/pagination/) and supports [Portfolio Access Tokens](https://mews-systems.gitbook.io/connector-api/concepts/multi-property).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "connector",
                "v1",
                "outletItems",
                "getAll"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },

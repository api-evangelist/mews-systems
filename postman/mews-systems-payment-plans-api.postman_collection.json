                              "raw": "{\n  \"AccessToken\": \"<string>\",\n  \"BillingAutomationId\": \"<uuid>\",\n  \"Client\": \"<string>\",\n  \"ClientToken\": \"<string>\",\n  \"CustomerId\": \"<uuid>\",\n  \"Name\": \"<string>\",\n  \"PaymentOffsetDays\": \"<integer>\",\n  \"PaymentRequest\": {\n    \"ExpirationDateUtc\": \"<dateTime>\",\n    \"Message\": \"<string>\",\n    \"PaymentMethods\": [\n      \"All\"\n    ],\n    \"SendEmail\": \"<boolean>\",\n    \"Note\": \"<string>\"\n  },\n  \"EnterpriseId\": \"<uuid>\",\n  \"StartMonth\": \"<string>\"\n}",
